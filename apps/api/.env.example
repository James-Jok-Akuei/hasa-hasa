# Local Postgres via docker-compose (pnpm --filter @hasahasa/api db:up)
DATABASE_URL="postgresql://hasahasa:hasahasa@localhost:5433/hasahasa?schema=public"

# Allowed browser origins for CORS. Comma-separated for more than one.
# In development, private LAN addresses (192.168.x, 10.x, 172.16-31.x) are
# also accepted so the app can be opened from a phone on the same wifi.
# In production only this list is allowed — nothing else.
WEB_ORIGIN="http://localhost:3000"

# openssl rand -hex 32
AUTH_SECRET="replace-me-with-64-random-hex-chars-openssl-rand-hex-32"

PORT=4000
NODE_ENV=development

# Email delivery for one-time codes.
#
# "console" prints the code to the terminal — no provider needed in dev.
# It is REFUSED when NODE_ENV=production: the API would boot cleanly and then
# let nobody sign in, which is worse than not booting.
#
# For "resend", both RESEND_API_KEY and RESEND_FROM are required at boot.
# The sending domain must be verified with Resend first — an unverified
# sender fails at send time, not at boot, so the API looks healthy while
# every sign-in fails.
EMAIL_PROVIDER=console
# RESEND_API_KEY="re_..."
# RESEND_FROM="HASA HASA <noreply@yourdomain.com>"
